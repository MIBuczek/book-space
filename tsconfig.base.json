{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@models/*": ["./libs/models/*"],
      "@server/auth/*": ["./apps/server/src/app/authorization/*"],
      "@server/bookings/*": ["./apps/server/src/app/bookings/*"],
      "@server/buildings/*": ["./apps/server/src/app/buildings/*"],
      "@server/clients/*": ["./apps/server/src/app/clients/*"],
      "@server/notify/*": ["./apps/server/src/app/notification/*"],
      "@server/strategy/*": ["./apps/server/src/app/strategy/*"],
      "@server/testing/*": ["./apps/server/src/testing/*"],
      "@server/users/*": ["./apps/server/src/app/users/*"],
      "@server/utils/*": ["./apps/server/src/app/utility/*"],
      "@booking/date-time": ["./libs/date-time/src/index.ts"],
      "@booking/rules": ["./libs/booking-rules/src/index.ts"],
      "@booking/reporting": ["./libs/reporting/src/index.ts"],
      "@booking/version": ["./libs/version/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
