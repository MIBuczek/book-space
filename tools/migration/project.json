{
  "name": "migration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/migration/src",
  "projectType": "application",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node --transpile-only --project tools/migration/tsconfig.json tools/migration/src/main.ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "tools/migration/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["tools/migration/**/*.ts"]
      }
    }
  }
}
