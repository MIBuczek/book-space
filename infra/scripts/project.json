{
  "name": "ensure-collections",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "infra/scripts/src",
  "projectType": "application",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node --transpile-only -r tsconfig-paths/register --project infra/scripts/tsconfig.json infra/scripts/src/main.ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "infra/scripts/jest.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["infra/scripts/**/*.ts"]
      }
    }
  }
}
