# Copy to apps/server/.env and fill in real values. Never commit the real file.
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-value>

# Seed the twelve reference facilities from spec.md section 4 on startup. Off by
# default: the seed is authoritative, so running it overwrites an administrator's
# edits to a facility. Set to the exact string `true` to enable it; any other value
# (including `false`) leaves it off.
SEED_REFERENCE_DATA=false

# Accounts denied the Summary feature (FR-006), comma-separated. Unset keeps the legacy
# default (mkulakowski@umsiechnice.pl). Set to an empty value only if no account should
# be denied.
SUMMARY_DENY_LIST=mkulakowski@umsiechnice.pl

# Outbound mail (FR-032-FR-036). The provider is reached over HTTP: the message is POSTed
# as JSON to MAIL_ENDPOINT with a bearer token when MAIL_API_KEY is set. Leave the endpoint
# unset to disable sending; a notification then fails visibly (502) rather than silently.
MAIL_ENDPOINT=
MAIL_API_KEY=
MAIL_FROM=bookings@example.com

# The SISK inbox for staff notifications and contact-form messages (FR-033, FR-034).
SISK_CONTACT_EMAIL=biuro@example.com
