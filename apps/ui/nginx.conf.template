server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # The SPA uses client-side routing; an unknown path is the app's own 404 page,
  # so every unmatched route falls through to index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # `/api` is proxied to the API container. `${API_UPSTREAM}` is substituted from
  # the environment by the nginx image's entrypoint (envsubst) at start-up.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
